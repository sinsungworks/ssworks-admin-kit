{
  "name": "ssworks-admin-kit",
  "private": true,
  "type": "module",
  "description": "관리자 페이지 공통 패키지 모노레포 — @ssworks/admin-shared · @ssworks/admin-ui · @ssworks/admin-server",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "prepare": "pnpm --filter @ssworks/admin-shared build",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1"
  }
}
