{
  "name": "ssworks-admin-kit",
  "private": true,
  "type": "module",
  "description": "관리자 페이지 공통 패키지 모노레포 — @ssworks/admin-shared · @ssworks/admin-ui · @ssworks/admin-server",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "prepare": "pnpm --filter @ssworks/admin-shared build",
    "build": "pnpm -r build",
    "check:dts": "pnpm -r --if-present check:dts",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "pnpm --filter @ssworks/admin-server test:db",
    "db:test:up": "docker run -d --name admin-kit-test-db -e MARIADB_ROOT_PASSWORD=admin-kit-test -p 33306:3306 mariadb:11.4",
    "db:test:down": "docker rm -f admin-kit-test-db",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:dts",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && node scripts/stage-release.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1"
  }
}
