{
  "name": "@ssworks/admin-ui",
  "version": "0.1.0",
  "description": "관리자 페이지 공통 Vue 3 + Vuetify 4 컴포넌트·composable — 레이아웃 프리미티브, 다이얼로그, 서버 페이지네이션 표, 토스트, Vuetify 프리셋, 권한 판정 훅.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.vue"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sinsungworks/ssworks-admin-kit.git",
    "directory": "packages/admin-ui"
  },
  "scripts": {
    "build": "rimraf dist && vue-tsc --noEmit -p tsconfig.build.json && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@ssworks/admin-shared": "workspace:^",
    "vue": "^3.5.0",
    "vue-router": "^4.5 || ^5",
    "vuetify": "^4.0.0"
  },
  "devDependencies": {
    "@mdi/font": "^7.4.47",
    "@ssworks/admin-shared": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.0.0",
    "rimraf": "^6.0.1",
    "typescript": "~5.9.2",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.0.0",
    "vitest": "^4.1.10",
    "vue": "^3.5.21",
    "vue-router": "^4.6.0",
    "vue-tsc": "^3.1.1",
    "vuetify": "^4.0.5",
    "zod": "^4.3.5"
  }
}
